# 既定: リポジトリには LF で格納し、チェックアウト時に環境へ合わせる
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.props   text
*.json    text
*.md      text
*.gitignore text

# Visual Studio が CRLF を要求する
*.sln     text eol=crlf

# 画像は改行変換の対象外にする（text=auto の判定に任せると壊れうる）
*.ico     binary
*.png     binary
