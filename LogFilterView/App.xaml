<Application x:Class="LogFilterView.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LogFilterView.Views">
    <Application.Resources>
        <ResourceDictionary>
            <v:EnumBooleanConverter x:Key="EnumBool" />
            <v:WordWrapToScrollBarConverter x:Key="WrapToScroll" />
            <v:InverseBooleanConverter x:Key="InverseBool" />
            <v:NullToVisibilityConverter x:Key="NullToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PatternBox" TargetType="TextBox">
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="AcceptsTab" Value="False" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="FontFamily" Value="Consolas, MS Gothic" />
                <Setter Property="SpellCheck.IsEnabled" Value="False" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <!-- 100 万行を並べるので、行コンテナは可能な限り軽くする -->
            <Style x:Key="LineItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="2,0,2,0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFCDE4F7" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 横スクロールで左端の帯が見えなくなっても分かるように、行全体を淡く塗る -->
                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                        <Setter Property="Background" Value="#FFFFF1DC" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="LineTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- マーカー帯 4px + 余白 5px。列幅が帯とマージンの合計より狭いと帯が潰れる -->
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- マーカーの目印 -->
                    <Border Grid.Column="0" Width="4" HorizontalAlignment="Left" CornerRadius="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                        <Setter Property="Background" Value="#FFF57C00" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding LineNumberText}"
                               Width="{Binding Tag.LineNumberWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               Visibility="{Binding Tag.LineNumberVisibility, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               TextAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF8A8A8A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                        <Setter Property="Foreground" Value="#FFE65100" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Top"
                               TextWrapping="{Binding Tag.TextWrapping, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               MinWidth="{Binding Tag.ContentMinWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               v:TextHighlighter.SourceText="{Binding Text}"
                               v:TextHighlighter.Rules="{Binding Tag.Highlight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- 条件に一致した行ではなく、前後の文脈として出ている行は淡く表示する -->
                                    <DataTrigger Binding="{Binding IsContext}" Value="True">
                                        <Setter Property="Foreground" Value="#FF9E9E9E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
